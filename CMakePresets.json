{
  "version": 3,
  "configurePresets": [
    {
      "name": "vcpkg",
      "generator": "Visual Studio 18 2026",
      "architecture": "Win32",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_OVERLAY_TRIPLETS": "${sourceDir}/vcpkg-overlays/triplets",
        "VCPKG_TARGET_TRIPLET": "x86-windows-mixed"
      }
    },
    {
      "name": "clang",
      "inherits": "vcpkg",
      "displayName": "clang-cl (experimental, Ninja)",
      "generator": "Ninja",
      "architecture": {
        "value": "Win32",
        "strategy": "external"
      },
      "binaryDir": "${sourceDir}/build-clang",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang-cl",
        "CMAKE_CXX_COMPILER": "clang-cl",
        "CMAKE_RC_COMPILER": "llvm-rc",
        "CMAKE_C_FLAGS_INIT": "-m32",
        "CMAKE_CXX_FLAGS_INIT": "-m32"
      }
    },
    {
      "name": "wine",
      "inherits": "vcpkg",
      "displayName": "Real MSVC under Wine (Ninja, headless Linux build)",
      "generator": "Ninja",
      "architecture": {
        "value": "Win32",
        "strategy": "external"
      },
      "binaryDir": "${sourceDir}/build-wine",
      "cacheVariables": {
        "CMAKE_SYSTEM_NAME": "Windows",
        "CMAKE_SYSTEM_PROCESSOR": "x86",
        "CMAKE_C_COMPILER": "cl",
        "CMAKE_CXX_COMPILER": "cl",
        "CMAKE_RC_COMPILER": "rc",
        "CMAKE_JOB_POOL_COMPILE": "console",
        "CMAKE_JOB_POOL_LINK": "console",
        "FXC": "/opt/msvc/bin/x86/fxc",
        "VCPKG_OVERLAY_TRIPLETS": "${sourceDir}/scripts/wine-msvc/vcpkg-triplets;${sourceDir}/vcpkg-overlays/triplets"
      }
    },
    {
      "name": "xwin",
      "inherits": "vcpkg",
      "displayName": "clang-cl + xwin (Ninja, native Linux build, no wine)",
      "description": "Cross-compiles the x86 Windows target on Linux with clang-cl/lld-link against an xwin-supplied MSVC + Windows SDK. Needs XWIN_SDK (and VKD3D_COMPILER, the fxc stand-in for the SM3 shaders) in the environment -- see scripts/xwin/setup-toolchain.sh.",
      "generator": "Ninja",
      "architecture": {
        "value": "Win32",
        "strategy": "external"
      },
      "binaryDir": "${sourceDir}/build-xwin",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_CHAINLOAD_TOOLCHAIN_FILE": "${sourceDir}/scripts/xwin/vcpkg-triplets/xwin-toolchain.cmake",
        "VCPKG_OVERLAY_TRIPLETS": "${sourceDir}/scripts/xwin/vcpkg-triplets",
        "VCPKG_TARGET_TRIPLET": "x86-windows-mixed",
        "XWIN_SDK": "$env{XWIN_SDK}"
      }
    },
    {
      "name": "wasm",
      "displayName": "GWToolboxdll.wasm (Emscripten, MVP scaffold)",
      "description": "Builds the wasm MVP scaffold only (GWToolboxdll/Wasm/*) -- not the real product; see GWToolboxdll/Wasm/main_wasm.cpp for scope. Needs EMSDK set. Not inherited from `vcpkg`: none of the Win32/VS/vcpkg-triplet settings apply cross-compiling for wasm.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-wasm",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{EMSDK}/upstream/emscripten/cmake/Modules/Platform/Emscripten.cmake"
      },
      "environment": {
        "EMSDK_QUIET": "1"
      }
    }
  ]
}
