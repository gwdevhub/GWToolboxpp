{
  "version": 3,
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "displayName": "Base (not for selection)",
      "description": "Builds the x86 Windows target with llvm-mingw (clang, lld, libc++, MinGW-w64) from .toolchain/, on Linux or Windows, each host in its own build/<host>/ so a dual-boot checkout keeps both; each binary gets a .pdb. vcpkg comes from VCPKG_ROOT or .vcpkg/. The bootstrap scripts install both - see bootstrap/README.md.",
      "generator": "Ninja",
      "architecture": {
        "value": "Win32",
        "strategy": "external"
      },
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/cmake/vcpkg-toolchain.cmake",
        "VCPKG_CHAINLOAD_TOOLCHAIN_FILE": "${sourceDir}/cmake/toolchain.cmake",
        "VCPKG_OVERLAY_TRIPLETS": "${sourceDir}/vcpkg-overlays/triplets",
        "VCPKG_TARGET_TRIPLET": "x86-mingw-mixed",
        "CMAKE_SHARED_LINKER_FLAGS": "-static -Wl,--pdb=",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "VCPKG_APPLOCAL_DEPS": "OFF",
        "VCPKG_INSTALLED_DIR": "${sourceDir}/build/${hostSystemName}/vcpkg_installed"
      },
      "vendor": {
        "microsoft.com/VisualStudioSettings/CMake/1.0": {
          "hostOS": [
            "Windows",
            "Linux"
          ],
          "intelliSenseMode": "windows-clang-x86"
        }
      }
    },
    {
      "name": "relwithdebinfo",
      "inherits": "base",
      "displayName": "RelWithDebInfo (build/<host>/relwithdebinfo/)",
      "binaryDir": "${sourceDir}/build/${hostSystemName}/relwithdebinfo",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    },
    {
      "name": "debug",
      "inherits": "base",
      "displayName": "Debug (build/<host>/debug/)",
      "binaryDir": "${sourceDir}/build/${hostSystemName}/debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "release",
      "inherits": "base",
      "displayName": "Release (build/<host>/release/)",
      "binaryDir": "${sourceDir}/build/${hostSystemName}/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "wasm",
      "displayName": "GWToolboxdll.wasm (Emscripten, MVP scaffold)",
      "description": "Builds the wasm MVP scaffold only (GWToolboxdll/Wasm/*) -- not the real product; see GWToolboxdll/Wasm/main_wasm.cpp for scope. Needs EMSDK set. Not inherited from `base`: none of the Win32/vcpkg-triplet settings apply cross-compiling for wasm.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${hostSystemName}/wasm",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{EMSDK}/upstream/emscripten/cmake/Modules/Platform/Emscripten.cmake"
      },
      "environment": {
        "EMSDK_QUIET": "1"
      }
    },
    {
      "name": "GWToolbox (Linux)",
      "displayName": "GWToolbox (Linux): the Linux launcher, which embeds GWToolbox.exe",
      "description": "Configures the Linux launcher (GWToolboxLinux) with the host's compiler, in build/Linux/native. Only on Linux: its build embeds GWToolbox.exe, which the Windows build of the same repo produces.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${hostSystemName}/native",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    }
  ]
}
