#pragma once

// Generated by CMake (configure_file, see cmake/gwtoolboxdll_plugins.cmake) from
// SCTRACKER_PLUGIN_VERSION - bump that CMake variable, not this file, whenever a new build should be
// treated as required by the backend's minimum-version check (PluginVersionMetadataLoader on the
// backend, X-Plugin-Version on every request here). Regenerated automatically whenever
// SCTRACKER_PLUGIN_VERSION changes, since editing gwtoolboxdll_plugins.cmake triggers a CMake
// reconfigure before the next build. See also plugins/Base/write-plugin-manifest.cmake, the generic
// POST_BUILD step add_tb_plugin() runs for every plugin, which stamps the companion
// SCTracker.version.json with this same version plus a fresh build timestamp and the dll's SHA-256
// on every single build, not just when the version number changes.
constexpr int kPluginVersion = @SCTRACKER_PLUGIN_VERSION@;
